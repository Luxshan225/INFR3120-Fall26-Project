#!/usr/bin/env node

require('dotenv').config({ quiet: true });

const mongoose = require('mongoose');
const app = require('../app');

const port = Number(process.env.PORT || 3000);

async function start() {
  if (!process.env.MONGODB_URI) {
    console.error('Set MONGODB_URI before starting the application.');
    process.exitCode = 1;
    return;
  }

  try {
    await mongoose.connect(process.env.MONGODB_URI, {
      serverSelectionTimeoutMS: 10000
    });
  } catch (error) {
    console.error(`MongoDB connection failed (${error.name}). Check the URI, database user, and Atlas IP access list.`);
    process.exitCode = 1;
    return;
  }

  const server = app.listen(port, '0.0.0.0', () => {
    console.log(`Campus Gear Board is listening on port ${port}.`);
  });

  server.on('error', async (error) => {
    console.error(`Server startup failed (${error.code || error.name}).`);
    process.exitCode = 1;
    await mongoose.disconnect();
  });
}

start();